{
  "name": "zynora-store",
  "version": "1.0.0",
  "private": true,
  "description": "ZYNORA electronics store with PostgreSQL orders and MBank QR checkout",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "admin:hash": "node scripts/hash-password.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "pg": "^8.16.3",
    "prisma": "6.19.0",
    "zod": "^4.1.12"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "prisma@6.19.0": true,
    "@prisma/engines@6.19.0": true
  }
}
